{
  "name": "Bookshelf Night",
  "author": "Richard Ward (zeamp)",
  "variables": {
    "bg": "#231D19",
    "fg": "#E6DBCF",
    "accent": "#4FB5A8"
  },
  "globals": {
    "background": "#231D19",
    "foreground": "#E6DBCF",
    "caret": "#EFCB8A",
    "block_caret": "#EFCB8A",
    "line_highlight": "#1B1613",
    "selection": "#4A3F2E",
    "selection_border": "#4A3F2E",
    "inactive_selection": "#1B1613",
    "misc_highlight": "#433830",
    "find_highlight": "#EFCB8A",
    "find_highlight_foreground": "#231D19",
    "highlight": "#4FB5A8",
    "highlight_foreground": "#231D19",
    "brackets_options": "underline",
    "brackets_foreground": "#4FB5A8",
    "bracket_contents_options": "underline",
    "bracket_contents_foreground": "#4FB5A8",
    "tags_options": "stippled_underline",
    "tags_foreground": "#4FB5A8",
    "guide": "#433830",
    "active_guide": "#B3A08B",
    "stack_guide": "#433830",
    "gutter": "#231D19",
    "gutter_foreground": "#8A7967",
    "shadow": "#150F0C"
  },
  "rules": [
    {
      "name": "comment",
      "scope": "comment, punctuation.definition.comment",
      "foreground": "#8A7967",
      "font_style": "italic"
    },
    {
      "name": "string",
      "scope": "string, punctuation.definition.string",
      "foreground": "#9CC27A"
    },
    {
      "name": "constant.numeric",
      "scope": "constant.numeric",
      "foreground": "#E39A5C"
    },
    {
      "name": "constant.language",
      "scope": "constant.language, constant.character, constant.other",
      "foreground": "#E39A5C"
    },
    {
      "name": "keyword",
      "scope": "keyword, storage",
      "foreground": "#C79BC7"
    },
    {
      "name": "keyword.operator",
      "scope": "keyword.operator",
      "foreground": "#5CC4B7"
    },
    {
      "name": "entity.name.function",
      "scope": "entity.name.function, support.function, meta.function-call",
      "foreground": "#7FB2D1"
    },
    {
      "name": "entity.name.class",
      "scope": "entity.name.class, entity.name.type, support.class, support.type",
      "foreground": "#EFCB8A"
    },
    {
      "name": "entity.other.inherited-class",
      "scope": "entity.other.inherited-class",
      "foreground": "#EFCB8A",
      "font_style": "italic"
    },
    {
      "name": "variable.parameter",
      "scope": "variable.parameter",
      "foreground": "#E6DBCF",
      "font_style": "italic"
    },
    {
      "name": "variable",
      "scope": "variable, variable.other",
      "foreground": "#E6DBCF"
    },
    {
      "name": "variable.language",
      "scope": "variable.language, support.constant",
      "foreground": "#E0786B"
    },
    {
      "name": "entity.name.tag",
      "scope": "entity.name.tag",
      "foreground": "#E0786B"
    },
    {
      "name": "entity.other.attribute-name",
      "scope": "entity.other.attribute-name",
      "foreground": "#EFCB8A",
      "font_style": "italic"
    },
    {
      "name": "punctuation",
      "scope": "punctuation, meta.brace",
      "foreground": "#B3A08B"
    },
    {
      "name": "markup.heading",
      "scope": "markup.heading, entity.name.section",
      "foreground": "#4FB5A8",
      "font_style": "bold"
    },
    {
      "name": "markup.bold",
      "scope": "markup.bold",
      "foreground": "#E6DBCF",
      "font_style": "bold"
    },
    {
      "name": "markup.italic",
      "scope": "markup.italic",
      "foreground": "#E6DBCF",
      "font_style": "italic"
    },
    {
      "name": "markup.underline.link",
      "scope": "markup.underline.link, string.other.link",
      "foreground": "#7DD3C7",
      "font_style": "underline"
    },
    {
      "name": "markup.quote",
      "scope": "markup.quote",
      "foreground": "#B3A08B",
      "font_style": "italic"
    },
    {
      "name": "markup.raw",
      "scope": "markup.raw, markup.inline.raw",
      "foreground": "#9CC27A"
    },
    {
      "name": "markup.inserted",
      "scope": "markup.inserted",
      "foreground": "#9CC27A"
    },
    {
      "name": "markup.deleted",
      "scope": "markup.deleted",
      "foreground": "#E0786B"
    },
    {
      "name": "markup.changed",
      "scope": "markup.changed",
      "foreground": "#7FB2D1"
    },
    {
      "name": "invalid",
      "scope": "invalid, invalid.illegal",
      "foreground": "#F0645A"
    },
    {
      "name": "invalid.deprecated",
      "scope": "invalid.deprecated",
      "foreground": "#EFB04A",
      "font_style": "italic"
    },
    {
      "name": "support.constant.property-value",
      "scope": "support.constant.property-value, meta.property-value",
      "foreground": "#5CC4B7"
    },
    {
      "name": "meta.selector",
      "scope": "meta.selector, entity.other.attribute-name.class, entity.other.attribute-name.id",
      "foreground": "#EFCB8A"
    },
    {
      "name": "constant.other.color",
      "scope": "constant.other.color",
      "foreground": "#E39A5C"
    },
    {
      "name": "string.regexp",
      "scope": "string.regexp",
      "foreground": "#5CC4B7"
    },
    {
      "name": "constant.character.escape",
      "scope": "constant.character.escape",
      "foreground": "#5CC4B7"
    }
  ]
}