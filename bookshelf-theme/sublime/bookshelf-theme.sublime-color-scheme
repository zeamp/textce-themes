{
  "name": "Bookshelf",
  "author": "Richard Ward (zeamp)",
  "variables": {
    "bg": "#E6DBCF",
    "fg": "#22504C",
    "accent": "#2A8C82"
  },
  "globals": {
    "background": "#E6DBCF",
    "foreground": "#22504C",
    "caret": "#0B615A",
    "block_caret": "#0B615A",
    "line_highlight": "#DCCEC3",
    "selection": "#EFCB8A",
    "selection_border": "#EFCB8A",
    "inactive_selection": "#DCCEC3",
    "misc_highlight": "#C9B9AA",
    "find_highlight": "#EFCB8A",
    "find_highlight_foreground": "#E6DBCF",
    "highlight": "#2A8C82",
    "highlight_foreground": "#E6DBCF",
    "brackets_options": "underline",
    "brackets_foreground": "#2A8C82",
    "bracket_contents_options": "underline",
    "bracket_contents_foreground": "#2A8C82",
    "tags_options": "stippled_underline",
    "tags_foreground": "#2A8C82",
    "guide": "#C9B9AA",
    "active_guide": "#6B5443",
    "stack_guide": "#C9B9AA",
    "gutter": "#E6DBCF",
    "gutter_foreground": "#8C7868",
    "shadow": "#D3C4B7"
  },
  "rules": [
    {
      "name": "comment",
      "scope": "comment, punctuation.definition.comment",
      "foreground": "#8C7868",
      "font_style": "italic"
    },
    {
      "name": "string",
      "scope": "string, punctuation.definition.string",
      "foreground": "#2F6B3A"
    },
    {
      "name": "constant.numeric",
      "scope": "constant.numeric",
      "foreground": "#9A3F1D"
    },
    {
      "name": "constant.language",
      "scope": "constant.language, constant.character, constant.other",
      "foreground": "#9A3F1D"
    },
    {
      "name": "keyword",
      "scope": "keyword, storage",
      "foreground": "#6D3A6D"
    },
    {
      "name": "keyword.operator",
      "scope": "keyword.operator",
      "foreground": "#0B615A"
    },
    {
      "name": "entity.name.function",
      "scope": "entity.name.function, support.function, meta.function-call",
      "foreground": "#2F5F7F"
    },
    {
      "name": "entity.name.class",
      "scope": "entity.name.class, entity.name.type, support.class, support.type",
      "foreground": "#7A5A0C"
    },
    {
      "name": "entity.other.inherited-class",
      "scope": "entity.other.inherited-class",
      "foreground": "#7A5A0C",
      "font_style": "italic"
    },
    {
      "name": "variable.parameter",
      "scope": "variable.parameter",
      "foreground": "#22504C",
      "font_style": "italic"
    },
    {
      "name": "variable",
      "scope": "variable, variable.other",
      "foreground": "#22504C"
    },
    {
      "name": "variable.language",
      "scope": "variable.language, support.constant",
      "foreground": "#8B2A3A"
    },
    {
      "name": "entity.name.tag",
      "scope": "entity.name.tag",
      "foreground": "#8B2A3A"
    },
    {
      "name": "entity.other.attribute-name",
      "scope": "entity.other.attribute-name",
      "foreground": "#7A5A0C",
      "font_style": "italic"
    },
    {
      "name": "punctuation",
      "scope": "punctuation, meta.brace",
      "foreground": "#6B5443"
    },
    {
      "name": "markup.heading",
      "scope": "markup.heading, entity.name.section",
      "foreground": "#2A8C82",
      "font_style": "bold"
    },
    {
      "name": "markup.bold",
      "scope": "markup.bold",
      "foreground": "#22504C",
      "font_style": "bold"
    },
    {
      "name": "markup.italic",
      "scope": "markup.italic",
      "foreground": "#22504C",
      "font_style": "italic"
    },
    {
      "name": "markup.underline.link",
      "scope": "markup.underline.link, string.other.link",
      "foreground": "#0B615A",
      "font_style": "underline"
    },
    {
      "name": "markup.quote",
      "scope": "markup.quote",
      "foreground": "#6B5443",
      "font_style": "italic"
    },
    {
      "name": "markup.raw",
      "scope": "markup.raw, markup.inline.raw",
      "foreground": "#2F6B3A"
    },
    {
      "name": "markup.inserted",
      "scope": "markup.inserted",
      "foreground": "#2F6B3A"
    },
    {
      "name": "markup.deleted",
      "scope": "markup.deleted",
      "foreground": "#8B2A3A"
    },
    {
      "name": "markup.changed",
      "scope": "markup.changed",
      "foreground": "#2F5F7F"
    },
    {
      "name": "invalid",
      "scope": "invalid, invalid.illegal",
      "foreground": "#DB332E"
    },
    {
      "name": "invalid.deprecated",
      "scope": "invalid.deprecated",
      "foreground": "#E69E17",
      "font_style": "italic"
    },
    {
      "name": "support.constant.property-value",
      "scope": "support.constant.property-value, meta.property-value",
      "foreground": "#0B615A"
    },
    {
      "name": "meta.selector",
      "scope": "meta.selector, entity.other.attribute-name.class, entity.other.attribute-name.id",
      "foreground": "#7A5A0C"
    },
    {
      "name": "constant.other.color",
      "scope": "constant.other.color",
      "foreground": "#9A3F1D"
    },
    {
      "name": "string.regexp",
      "scope": "string.regexp",
      "foreground": "#0B615A"
    },
    {
      "name": "constant.character.escape",
      "scope": "constant.character.escape",
      "foreground": "#0B615A"
    }
  ]
}