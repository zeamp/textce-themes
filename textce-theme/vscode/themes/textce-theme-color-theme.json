{
  "$schema": "vscode://schemas/color-theme",
  "name": "Textce",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#2A2A2A",
    "editor.foreground": "#E6E6E6",
    "editorCursor.foreground": "#8E8E93",
    "editor.selectionBackground": "#4A4A4CFF",
    "editor.inactiveSelectionBackground": "#4A4A4C66",
    "editor.selectionHighlightBackground": "#FFCE1B55",
    "editor.wordHighlightBackground": "#FFCE1B44",
    "editor.findMatchBackground": "#FFCE1BCC",
    "editor.findMatchHighlightBackground": "#FFCE1B66",
    "editor.lineHighlightBackground": "#2F2F2FFF",
    "editorLineNumber.foreground": "#9F9F9F",
    "editorLineNumber.activeForeground": "#F2F2F2",
    "editorIndentGuide.background1": "#3D3D3D",
    "editorIndentGuide.activeBackground1": "#9F9F9F",
    "editorWhitespace.foreground": "#3D3D3D",
    "editorBracketMatch.background": "#8E8E9333",
    "editorBracketMatch.border": "#8E8E93",
    "editorGutter.addedBackground": "#95C6A4",
    "editorGutter.modifiedBackground": "#88A5BF",
    "editorGutter.deletedBackground": "#C18E8B",
    "editorError.foreground": "#D0A7A5",
    "editorWarning.foreground": "#BFA188",
    "editorInfo.foreground": "#88A5BF",
    "editorWidget.background": "#1E1E1E",
    "editorWidget.border": "#3D3D3D",
    "editorSuggestWidget.background": "#1E1E1E",
    "editorSuggestWidget.selectedBackground": "#2F2F2F",
    "editorHoverWidget.background": "#1E1E1E",
    "editorHoverWidget.border": "#3D3D3D",
    "sideBar.background": "#2F2F2F",
    "sideBar.foreground": "#E6E6E6",
    "sideBar.border": "#3D3D3D",
    "sideBarTitle.foreground": "#F2F2F2",
    "sideBarSectionHeader.background": "#222222",
    "activityBar.background": "#2F2F2F",
    "activityBar.foreground": "#F2F2F2",
    "activityBar.inactiveForeground": "#9F9F9F",
    "activityBar.border": "#3D3D3D",
    "activityBarBadge.background": "#8E8E93",
    "activityBarBadge.foreground": "#111111",
    "statusBar.background": "#2F2F2F",
    "statusBar.foreground": "#C4C4C4",
    "statusBar.border": "#3D3D3D",
    "statusBar.debuggingBackground": "#BFA188",
    "titleBar.activeBackground": "#2F2F2F",
    "titleBar.activeForeground": "#E6E6E6",
    "titleBar.inactiveBackground": "#2F2F2F",
    "titleBar.inactiveForeground": "#9F9F9F",
    "titleBar.border": "#3D3D3D",
    "tab.activeBackground": "#2A2A2A",
    "tab.activeForeground": "#E6E6E6",
    "tab.inactiveBackground": "#2F2F2F",
    "tab.inactiveForeground": "#C4C4C4",
    "tab.border": "#3D3D3D",
    "tab.activeBorderTop": "#8E8E93",
    "editorGroupHeader.tabsBackground": "#2F2F2F",
    "editorGroup.border": "#3D3D3D",
    "panel.background": "#2A2A2A",
    "panel.border": "#3D3D3D",
    "panelTitle.activeForeground": "#E6E6E6",
    "panelTitle.activeBorder": "#8E8E93",
    "panelTitle.inactiveForeground": "#C4C4C4",
    "input.background": "#1E1E1E",
    "input.border": "#3D3D3D",
    "input.foreground": "#E6E6E6",
    "input.placeholderForeground": "#9F9F9F",
    "inputOption.activeBorder": "#8E8E93",
    "button.background": "#8E8E93",
    "button.foreground": "#111111",
    "button.hoverBackground": "#F2F2F2",
    "dropdown.background": "#1E1E1E",
    "dropdown.border": "#3D3D3D",
    "dropdown.foreground": "#E6E6E6",
    "list.activeSelectionBackground": "#8E8E9333",
    "list.activeSelectionForeground": "#E6E6E6",
    "list.inactiveSelectionBackground": "#222222",
    "list.hoverBackground": "#22222299",
    "list.highlightForeground": "#F2F2F2",
    "focusBorder": "#8E8E93",
    "foreground": "#E6E6E6",
    "descriptionForeground": "#C4C4C4",
    "errorForeground": "#D0A7A5",
    "textLink.foreground": "#F2F2F2",
    "textLink.activeForeground": "#8E8E93",
    "scrollbarSlider.background": "#9F9F9F44",
    "scrollbarSlider.hoverBackground": "#9F9F9F77",
    "scrollbarSlider.activeBackground": "#9F9F9F99",
    "badge.background": "#8E8E93",
    "badge.foreground": "#111111",
    "progressBar.background": "#8E8E93",
    "gitDecoration.addedResourceForeground": "#95C6A4",
    "gitDecoration.modifiedResourceForeground": "#88A5BF",
    "gitDecoration.deletedResourceForeground": "#C18E8B",
    "gitDecoration.untrackedResourceForeground": "#95C6A4",
    "gitDecoration.ignoredResourceForeground": "#9F9F9F",
    "terminal.background": "#2A2A2A",
    "terminal.foreground": "#E6E6E6",
    "terminalCursor.foreground": "#8E8E93",
    "terminal.selectionBackground": "#4A4A4CAA",
    "diffEditor.insertedTextBackground": "#95C6A422",
    "diffEditor.removedTextBackground": "#C18E8B22",
    "peekView.border": "#8E8E93",
    "peekViewEditor.background": "#1E1E1E",
    "peekViewResult.background": "#2F2F2F",
    "peekViewTitle.background": "#2F2F2F",
    "breadcrumb.foreground": "#C4C4C4",
    "breadcrumb.focusForeground": "#E6E6E6",
    "menu.background": "#1E1E1E",
    "menu.foreground": "#E6E6E6",
    "menu.selectionBackground": "#8E8E9333",
    "notifications.background": "#1E1E1E",
    "notifications.border": "#3D3D3D",
    "terminal.ansiBlack": "#3D3D3D",
    "terminal.ansiBrightBlack": "#797979",
    "terminal.ansiRed": "#C18E8B",
    "terminal.ansiBrightRed": "#D0A7A5",
    "terminal.ansiGreen": "#95C6A4",
    "terminal.ansiBrightGreen": "#AFD5BA",
    "terminal.ansiYellow": "#C6B995",
    "terminal.ansiBrightYellow": "#D5CBAF",
    "terminal.ansiBlue": "#88A5BF",
    "terminal.ansiBrightBlue": "#A2B9CE",
    "terminal.ansiMagenta": "#B18FC3",
    "terminal.ansiBrightMagenta": "#C4A9D2",
    "terminal.ansiCyan": "#95C6BF",
    "terminal.ansiBrightCyan": "#AFD5D0",
    "terminal.ansiWhite": "#CFCFCF",
    "terminal.ansiBrightWhite": "#F1F1F1"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9F9F9F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#95C6A4"
      }
    },
    {
      "name": "Escape / regex",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#BFA188"
      }
    },
    {
      "name": "Number & constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other"
      ],
      "settings": {
        "foreground": "#BFA188"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#B18FC3"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#C4C4C4"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#88A5BF"
      }
    },
    {
      "name": "Type / class",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#C6B995"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#E6E6E6"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#C4C4C4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#F2F2F2"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#95C6BF"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#BFA188",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Import / module",
      "scope": [
        "entity.name.namespace",
        "support.module",
        "meta.import"
      ],
      "settings": {
        "foreground": "#C6B995"
      }
    },
    {
      "name": "Decorator",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#88A5BF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#D0A7A5"
      }
    },
    {
      "name": "Markup heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#F2F2F2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#E6E6E6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#E6E6E6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#F2F2F2"
      }
    },
    {
      "name": "Markup code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#95C6A4"
      }
    },
    {
      "name": "Diff added",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#95C6A4"
      }
    },
    {
      "name": "Diff removed",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#C18E8B"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#88A5BF"
      }
    }
  ]
}
