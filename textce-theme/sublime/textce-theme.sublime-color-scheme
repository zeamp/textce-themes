{
  "name": "Textce",
  "author": "Richard Ward (zeamp)",
  "variables": {
    "bg": "#2A2A2A",
    "fg": "#E6E6E6",
    "accent": "#8E8E93"
  },
  "globals": {
    "background": "#2A2A2A",
    "foreground": "#E6E6E6",
    "caret": "#8E8E93",
    "block_caret": "#8E8E93",
    "line_highlight": "#2F2F2F",
    "selection": "#4A4A4C",
    "selection_border": "#4A4A4C",
    "inactive_selection": "#2F2F2F",
    "misc_highlight": "#3D3D3D",
    "find_highlight": "#FFCE1B",
    "find_highlight_foreground": "#2A2A2A",
    "highlight": "#8E8E93",
    "highlight_foreground": "#2A2A2A",
    "brackets_options": "underline",
    "brackets_foreground": "#8E8E93",
    "bracket_contents_options": "underline",
    "bracket_contents_foreground": "#8E8E93",
    "tags_options": "stippled_underline",
    "tags_foreground": "#8E8E93",
    "guide": "#3D3D3D",
    "active_guide": "#C4C4C4",
    "stack_guide": "#3D3D3D",
    "gutter": "#2A2A2A",
    "gutter_foreground": "#9F9F9F",
    "shadow": "#222222"
  },
  "rules": [
    {
      "name": "comment",
      "scope": "comment, punctuation.definition.comment",
      "foreground": "#9F9F9F",
      "font_style": "italic"
    },
    {
      "name": "string",
      "scope": "string, punctuation.definition.string",
      "foreground": "#95C6A4"
    },
    {
      "name": "constant.numeric",
      "scope": "constant.numeric",
      "foreground": "#BFA188"
    },
    {
      "name": "constant.language",
      "scope": "constant.language, constant.character, constant.other",
      "foreground": "#BFA188"
    },
    {
      "name": "keyword",
      "scope": "keyword, storage",
      "foreground": "#B18FC3"
    },
    {
      "name": "keyword.operator",
      "scope": "keyword.operator",
      "foreground": "#95C6BF"
    },
    {
      "name": "entity.name.function",
      "scope": "entity.name.function, support.function, meta.function-call",
      "foreground": "#88A5BF"
    },
    {
      "name": "entity.name.class",
      "scope": "entity.name.class, entity.name.type, support.class, support.type",
      "foreground": "#C6B995"
    },
    {
      "name": "entity.other.inherited-class",
      "scope": "entity.other.inherited-class",
      "foreground": "#C6B995",
      "font_style": "italic"
    },
    {
      "name": "variable.parameter",
      "scope": "variable.parameter",
      "foreground": "#E6E6E6",
      "font_style": "italic"
    },
    {
      "name": "variable",
      "scope": "variable, variable.other",
      "foreground": "#E6E6E6"
    },
    {
      "name": "variable.language",
      "scope": "variable.language, support.constant",
      "foreground": "#C18E8B"
    },
    {
      "name": "entity.name.tag",
      "scope": "entity.name.tag",
      "foreground": "#C18E8B"
    },
    {
      "name": "entity.other.attribute-name",
      "scope": "entity.other.attribute-name",
      "foreground": "#C6B995",
      "font_style": "italic"
    },
    {
      "name": "punctuation",
      "scope": "punctuation, meta.brace",
      "foreground": "#C4C4C4"
    },
    {
      "name": "markup.heading",
      "scope": "markup.heading, entity.name.section",
      "foreground": "#8E8E93",
      "font_style": "bold"
    },
    {
      "name": "markup.bold",
      "scope": "markup.bold",
      "foreground": "#E6E6E6",
      "font_style": "bold"
    },
    {
      "name": "markup.italic",
      "scope": "markup.italic",
      "foreground": "#E6E6E6",
      "font_style": "italic"
    },
    {
      "name": "markup.underline.link",
      "scope": "markup.underline.link, string.other.link",
      "foreground": "#F2F2F2",
      "font_style": "underline"
    },
    {
      "name": "markup.quote",
      "scope": "markup.quote",
      "foreground": "#C4C4C4",
      "font_style": "italic"
    },
    {
      "name": "markup.raw",
      "scope": "markup.raw, markup.inline.raw",
      "foreground": "#95C6A4"
    },
    {
      "name": "markup.inserted",
      "scope": "markup.inserted",
      "foreground": "#95C6A4"
    },
    {
      "name": "markup.deleted",
      "scope": "markup.deleted",
      "foreground": "#C18E8B"
    },
    {
      "name": "markup.changed",
      "scope": "markup.changed",
      "foreground": "#88A5BF"
    },
    {
      "name": "invalid",
      "scope": "invalid, invalid.illegal",
      "foreground": "#D0A7A5"
    },
    {
      "name": "invalid.deprecated",
      "scope": "invalid.deprecated",
      "foreground": "#BFA188",
      "font_style": "italic"
    },
    {
      "name": "support.constant.property-value",
      "scope": "support.constant.property-value, meta.property-value",
      "foreground": "#95C6BF"
    },
    {
      "name": "meta.selector",
      "scope": "meta.selector, entity.other.attribute-name.class, entity.other.attribute-name.id",
      "foreground": "#C6B995"
    },
    {
      "name": "constant.other.color",
      "scope": "constant.other.color",
      "foreground": "#BFA188"
    },
    {
      "name": "string.regexp",
      "scope": "string.regexp",
      "foreground": "#95C6BF"
    },
    {
      "name": "constant.character.escape",
      "scope": "constant.character.escape",
      "foreground": "#95C6BF"
    }
  ]
}