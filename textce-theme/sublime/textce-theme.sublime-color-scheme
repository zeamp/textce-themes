{
  "name": "Textce",
  "author": "Richard Ward (zeamp)",
  "variables": {
    "bg": "#323232",
    "fg": "#D9D9D9",
    "accent": "#A7A7A7"
  },
  "globals": {
    "background": "#323232",
    "foreground": "#D9D9D9",
    "caret": "#A7A7A7",
    "block_caret": "#A7A7A7",
    "line_highlight": "#3C3C3D",
    "selection": "#494949",
    "selection_border": "#494949",
    "inactive_selection": "#3C3C3D",
    "misc_highlight": "#434343",
    "find_highlight": "#FAAC1C",
    "find_highlight_foreground": "#323232",
    "highlight": "#A7A7A7",
    "highlight_foreground": "#323232",
    "brackets_options": "underline",
    "brackets_foreground": "#A7A7A7",
    "bracket_contents_options": "underline",
    "bracket_contents_foreground": "#A7A7A7",
    "tags_options": "stippled_underline",
    "tags_foreground": "#A7A7A7",
    "guide": "#434343",
    "active_guide": "#B0B0B0",
    "stack_guide": "#434343",
    "gutter": "#323232",
    "gutter_foreground": "#999999",
    "shadow": "#232323"
  },
  "rules": [
    {
      "name": "comment",
      "scope": "comment, punctuation.definition.comment",
      "foreground": "#999999",
      "font_style": "italic"
    },
    {
      "name": "string",
      "scope": "string, punctuation.definition.string",
      "foreground": "#3BD862"
    },
    {
      "name": "constant.numeric",
      "scope": "constant.numeric",
      "foreground": "#F08A3C"
    },
    {
      "name": "constant.language",
      "scope": "constant.language, constant.character, constant.other",
      "foreground": "#F08A3C"
    },
    {
      "name": "keyword",
      "scope": "keyword, storage",
      "foreground": "#C67EF1"
    },
    {
      "name": "keyword.operator",
      "scope": "keyword.operator",
      "foreground": "#35C2B0"
    },
    {
      "name": "entity.name.function",
      "scope": "entity.name.function, support.function, meta.function-call",
      "foreground": "#58AEF3"
    },
    {
      "name": "entity.name.class",
      "scope": "entity.name.class, entity.name.type, support.class, support.type",
      "foreground": "#FAAC1C"
    },
    {
      "name": "entity.other.inherited-class",
      "scope": "entity.other.inherited-class",
      "foreground": "#FAAC1C",
      "font_style": "italic"
    },
    {
      "name": "variable.parameter",
      "scope": "variable.parameter",
      "foreground": "#D9D9D9",
      "font_style": "italic"
    },
    {
      "name": "variable",
      "scope": "variable, variable.other",
      "foreground": "#D9D9D9"
    },
    {
      "name": "variable.language",
      "scope": "variable.language, support.constant",
      "foreground": "#F37571"
    },
    {
      "name": "entity.name.tag",
      "scope": "entity.name.tag",
      "foreground": "#F37571"
    },
    {
      "name": "entity.other.attribute-name",
      "scope": "entity.other.attribute-name",
      "foreground": "#FAAC1C",
      "font_style": "italic"
    },
    {
      "name": "punctuation",
      "scope": "punctuation, meta.brace",
      "foreground": "#B0B0B0"
    },
    {
      "name": "markup.heading",
      "scope": "markup.heading, entity.name.section",
      "foreground": "#A7A7A7",
      "font_style": "bold"
    },
    {
      "name": "markup.bold",
      "scope": "markup.bold",
      "foreground": "#D9D9D9",
      "font_style": "bold"
    },
    {
      "name": "markup.italic",
      "scope": "markup.italic",
      "foreground": "#D9D9D9",
      "font_style": "italic"
    },
    {
      "name": "markup.underline.link",
      "scope": "markup.underline.link, string.other.link",
      "foreground": "#58AEF3",
      "font_style": "underline"
    },
    {
      "name": "markup.quote",
      "scope": "markup.quote",
      "foreground": "#B0B0B0",
      "font_style": "italic"
    },
    {
      "name": "markup.raw",
      "scope": "markup.raw, markup.inline.raw",
      "foreground": "#3BD862"
    },
    {
      "name": "markup.inserted",
      "scope": "markup.inserted",
      "foreground": "#3BD862"
    },
    {
      "name": "markup.deleted",
      "scope": "markup.deleted",
      "foreground": "#F37571"
    },
    {
      "name": "markup.changed",
      "scope": "markup.changed",
      "foreground": "#58AEF3"
    },
    {
      "name": "invalid",
      "scope": "invalid, invalid.illegal",
      "foreground": "#F37571"
    },
    {
      "name": "invalid.deprecated",
      "scope": "invalid.deprecated",
      "foreground": "#FAAC1C",
      "font_style": "italic"
    },
    {
      "name": "support.constant.property-value",
      "scope": "support.constant.property-value, meta.property-value",
      "foreground": "#35C2B0"
    },
    {
      "name": "meta.selector",
      "scope": "meta.selector, entity.other.attribute-name.class, entity.other.attribute-name.id",
      "foreground": "#FAAC1C"
    },
    {
      "name": "constant.other.color",
      "scope": "constant.other.color",
      "foreground": "#F08A3C"
    },
    {
      "name": "string.regexp",
      "scope": "string.regexp",
      "foreground": "#35C2B0"
    },
    {
      "name": "constant.character.escape",
      "scope": "constant.character.escape",
      "foreground": "#35C2B0"
    }
  ]
}