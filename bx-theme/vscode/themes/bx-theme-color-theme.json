{
  "$schema": "vscode://schemas/color-theme",
  "name": "BX",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#000000",
    "editor.foreground": "#C0C0C0",
    "editorCursor.foreground": "#FFD700",
    "editor.selectionBackground": "#524500FF",
    "editor.inactiveSelectionBackground": "#52450066",
    "editor.selectionHighlightBackground": "#FFCE1B55",
    "editor.wordHighlightBackground": "#FFCE1B44",
    "editor.findMatchBackground": "#FFCE1BCC",
    "editor.findMatchHighlightBackground": "#FFCE1B66",
    "editor.lineHighlightBackground": "#000000FF",
    "editorLineNumber.foreground": "#777777",
    "editorLineNumber.activeForeground": "#00FFFF",
    "editorIndentGuide.background1": "#2A2A2A",
    "editorIndentGuide.activeBackground1": "#777777",
    "editorWhitespace.foreground": "#2A2A2A",
    "editorBracketMatch.background": "#FFD70033",
    "editorBracketMatch.border": "#FFD700",
    "editorGutter.addedBackground": "#52FF52",
    "editorGutter.modifiedBackground": "#4272FF",
    "editorGutter.deletedBackground": "#FF3D3D",
    "editorError.foreground": "#FF6666",
    "editorWarning.foreground": "#FF9E3D",
    "editorInfo.foreground": "#4272FF",
    "editorWidget.background": "#000000",
    "editorWidget.border": "#2A2A2A",
    "editorSuggestWidget.background": "#000000",
    "editorSuggestWidget.selectedBackground": "#000000",
    "editorHoverWidget.background": "#000000",
    "editorHoverWidget.border": "#2A2A2A",
    "sideBar.background": "#000000",
    "sideBar.foreground": "#C0C0C0",
    "sideBar.border": "#2A2A2A",
    "sideBarTitle.foreground": "#00FFFF",
    "sideBarSectionHeader.background": "#000000",
    "activityBar.background": "#000000",
    "activityBar.foreground": "#00FFFF",
    "activityBar.inactiveForeground": "#777777",
    "activityBar.border": "#2A2A2A",
    "activityBarBadge.background": "#FFD700",
    "activityBarBadge.foreground": "#111111",
    "statusBar.background": "#000000",
    "statusBar.foreground": "#9D9D9D",
    "statusBar.border": "#2A2A2A",
    "statusBar.debuggingBackground": "#FF9E3D",
    "titleBar.activeBackground": "#000000",
    "titleBar.activeForeground": "#C0C0C0",
    "titleBar.inactiveBackground": "#000000",
    "titleBar.inactiveForeground": "#777777",
    "titleBar.border": "#2A2A2A",
    "tab.activeBackground": "#000000",
    "tab.activeForeground": "#C0C0C0",
    "tab.inactiveBackground": "#000000",
    "tab.inactiveForeground": "#9D9D9D",
    "tab.border": "#2A2A2A",
    "tab.activeBorderTop": "#FFD700",
    "editorGroupHeader.tabsBackground": "#000000",
    "editorGroup.border": "#2A2A2A",
    "panel.background": "#000000",
    "panel.border": "#2A2A2A",
    "panelTitle.activeForeground": "#C0C0C0",
    "panelTitle.activeBorder": "#FFD700",
    "panelTitle.inactiveForeground": "#9D9D9D",
    "input.background": "#000000",
    "input.border": "#2A2A2A",
    "input.foreground": "#C0C0C0",
    "input.placeholderForeground": "#777777",
    "inputOption.activeBorder": "#FFD700",
    "button.background": "#FFD700",
    "button.foreground": "#111111",
    "button.hoverBackground": "#00FFFF",
    "dropdown.background": "#000000",
    "dropdown.border": "#2A2A2A",
    "dropdown.foreground": "#C0C0C0",
    "list.activeSelectionBackground": "#FFD70033",
    "list.activeSelectionForeground": "#C0C0C0",
    "list.inactiveSelectionBackground": "#000000",
    "list.hoverBackground": "#00000099",
    "list.highlightForeground": "#00FFFF",
    "focusBorder": "#FFD700",
    "foreground": "#C0C0C0",
    "descriptionForeground": "#9D9D9D",
    "errorForeground": "#FF6666",
    "textLink.foreground": "#00FFFF",
    "textLink.activeForeground": "#FFD700",
    "scrollbarSlider.background": "#77777744",
    "scrollbarSlider.hoverBackground": "#77777777",
    "scrollbarSlider.activeBackground": "#77777799",
    "badge.background": "#FFD700",
    "badge.foreground": "#111111",
    "progressBar.background": "#FFD700",
    "gitDecoration.addedResourceForeground": "#52FF52",
    "gitDecoration.modifiedResourceForeground": "#4272FF",
    "gitDecoration.deletedResourceForeground": "#FF3D3D",
    "gitDecoration.untrackedResourceForeground": "#52FF52",
    "gitDecoration.ignoredResourceForeground": "#777777",
    "terminal.background": "#000000",
    "terminal.foreground": "#C0C0C0",
    "terminalCursor.foreground": "#FFD700",
    "terminal.selectionBackground": "#524500AA",
    "diffEditor.insertedTextBackground": "#52FF5222",
    "diffEditor.removedTextBackground": "#FF3D3D22",
    "peekView.border": "#FFD700",
    "peekViewEditor.background": "#000000",
    "peekViewResult.background": "#000000",
    "peekViewTitle.background": "#000000",
    "breadcrumb.foreground": "#9D9D9D",
    "breadcrumb.focusForeground": "#C0C0C0",
    "menu.background": "#000000",
    "menu.foreground": "#C0C0C0",
    "menu.selectionBackground": "#FFD70033",
    "notifications.background": "#000000",
    "notifications.border": "#2A2A2A",
    "terminal.ansiBlack": "#2A2A2A",
    "terminal.ansiBrightBlack": "#515151",
    "terminal.ansiRed": "#FF3D3D",
    "terminal.ansiBrightRed": "#FF6666",
    "terminal.ansiGreen": "#52FF52",
    "terminal.ansiBrightGreen": "#7BFF7B",
    "terminal.ansiYellow": "#FFFF52",
    "terminal.ansiBrightYellow": "#FFFF7B",
    "terminal.ansiBlue": "#4272FF",
    "terminal.ansiBrightBlue": "#6B90FF",
    "terminal.ansiMagenta": "#FF3DFF",
    "terminal.ansiBrightMagenta": "#FF66FF",
    "terminal.ansiCyan": "#52FFFF",
    "terminal.ansiBrightCyan": "#7BFFFF",
    "terminal.ansiWhite": "#ADADAD",
    "terminal.ansiBrightWhite": "#DCDCDC"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#777777",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#52FF52"
      }
    },
    {
      "name": "Escape / regex",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#FF9E3D"
      }
    },
    {
      "name": "Number & constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other"
      ],
      "settings": {
        "foreground": "#FF9E3D"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#FF3DFF"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#9D9D9D"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#4272FF"
      }
    },
    {
      "name": "Type / class",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#FFFF52"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#C0C0C0"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#9D9D9D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#00FFFF"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#52FFFF"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FF9E3D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Import / module",
      "scope": [
        "entity.name.namespace",
        "support.module",
        "meta.import"
      ],
      "settings": {
        "foreground": "#FFFF52"
      }
    },
    {
      "name": "Decorator",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#4272FF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#FF6666"
      }
    },
    {
      "name": "Markup heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#00FFFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#C0C0C0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#C0C0C0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#00FFFF"
      }
    },
    {
      "name": "Markup code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#52FF52"
      }
    },
    {
      "name": "Diff added",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#52FF52"
      }
    },
    {
      "name": "Diff removed",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FF3D3D"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#4272FF"
      }
    }
  ]
}
