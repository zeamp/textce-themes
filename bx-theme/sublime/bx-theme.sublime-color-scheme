{
  "name": "BX",
  "author": "Richard Ward (zeamp)",
  "variables": {
    "bg": "#000000",
    "fg": "#C0C0C0",
    "accent": "#FFD700"
  },
  "globals": {
    "background": "#000000",
    "foreground": "#C0C0C0",
    "caret": "#FFD700",
    "block_caret": "#FFD700",
    "line_highlight": "#000000",
    "selection": "#524500",
    "selection_border": "#524500",
    "inactive_selection": "#000000",
    "misc_highlight": "#2A2A2A",
    "find_highlight": "#FFCE1B",
    "find_highlight_foreground": "#000000",
    "highlight": "#FFD700",
    "highlight_foreground": "#000000",
    "brackets_options": "underline",
    "brackets_foreground": "#FFD700",
    "bracket_contents_options": "underline",
    "bracket_contents_foreground": "#FFD700",
    "tags_options": "stippled_underline",
    "tags_foreground": "#FFD700",
    "guide": "#2A2A2A",
    "active_guide": "#9D9D9D",
    "stack_guide": "#2A2A2A",
    "gutter": "#000000",
    "gutter_foreground": "#777777",
    "shadow": "#000000"
  },
  "rules": [
    {
      "name": "comment",
      "scope": "comment, punctuation.definition.comment",
      "foreground": "#777777",
      "font_style": "italic"
    },
    {
      "name": "string",
      "scope": "string, punctuation.definition.string",
      "foreground": "#52FF52"
    },
    {
      "name": "constant.numeric",
      "scope": "constant.numeric",
      "foreground": "#FF9E3D"
    },
    {
      "name": "constant.language",
      "scope": "constant.language, constant.character, constant.other",
      "foreground": "#FF9E3D"
    },
    {
      "name": "keyword",
      "scope": "keyword, storage",
      "foreground": "#FF3DFF"
    },
    {
      "name": "keyword.operator",
      "scope": "keyword.operator",
      "foreground": "#52FFFF"
    },
    {
      "name": "entity.name.function",
      "scope": "entity.name.function, support.function, meta.function-call",
      "foreground": "#4272FF"
    },
    {
      "name": "entity.name.class",
      "scope": "entity.name.class, entity.name.type, support.class, support.type",
      "foreground": "#FFFF52"
    },
    {
      "name": "entity.other.inherited-class",
      "scope": "entity.other.inherited-class",
      "foreground": "#FFFF52",
      "font_style": "italic"
    },
    {
      "name": "variable.parameter",
      "scope": "variable.parameter",
      "foreground": "#C0C0C0",
      "font_style": "italic"
    },
    {
      "name": "variable",
      "scope": "variable, variable.other",
      "foreground": "#C0C0C0"
    },
    {
      "name": "variable.language",
      "scope": "variable.language, support.constant",
      "foreground": "#FF3D3D"
    },
    {
      "name": "entity.name.tag",
      "scope": "entity.name.tag",
      "foreground": "#FF3D3D"
    },
    {
      "name": "entity.other.attribute-name",
      "scope": "entity.other.attribute-name",
      "foreground": "#FFFF52",
      "font_style": "italic"
    },
    {
      "name": "punctuation",
      "scope": "punctuation, meta.brace",
      "foreground": "#9D9D9D"
    },
    {
      "name": "markup.heading",
      "scope": "markup.heading, entity.name.section",
      "foreground": "#FFD700",
      "font_style": "bold"
    },
    {
      "name": "markup.bold",
      "scope": "markup.bold",
      "foreground": "#C0C0C0",
      "font_style": "bold"
    },
    {
      "name": "markup.italic",
      "scope": "markup.italic",
      "foreground": "#C0C0C0",
      "font_style": "italic"
    },
    {
      "name": "markup.underline.link",
      "scope": "markup.underline.link, string.other.link",
      "foreground": "#00FFFF",
      "font_style": "underline"
    },
    {
      "name": "markup.quote",
      "scope": "markup.quote",
      "foreground": "#9D9D9D",
      "font_style": "italic"
    },
    {
      "name": "markup.raw",
      "scope": "markup.raw, markup.inline.raw",
      "foreground": "#52FF52"
    },
    {
      "name": "markup.inserted",
      "scope": "markup.inserted",
      "foreground": "#52FF52"
    },
    {
      "name": "markup.deleted",
      "scope": "markup.deleted",
      "foreground": "#FF3D3D"
    },
    {
      "name": "markup.changed",
      "scope": "markup.changed",
      "foreground": "#4272FF"
    },
    {
      "name": "invalid",
      "scope": "invalid, invalid.illegal",
      "foreground": "#FF6666"
    },
    {
      "name": "invalid.deprecated",
      "scope": "invalid.deprecated",
      "foreground": "#FF9E3D",
      "font_style": "italic"
    },
    {
      "name": "support.constant.property-value",
      "scope": "support.constant.property-value, meta.property-value",
      "foreground": "#52FFFF"
    },
    {
      "name": "meta.selector",
      "scope": "meta.selector, entity.other.attribute-name.class, entity.other.attribute-name.id",
      "foreground": "#FFFF52"
    },
    {
      "name": "constant.other.color",
      "scope": "constant.other.color",
      "foreground": "#FF9E3D"
    },
    {
      "name": "string.regexp",
      "scope": "string.regexp",
      "foreground": "#52FFFF"
    },
    {
      "name": "constant.character.escape",
      "scope": "constant.character.escape",
      "foreground": "#52FFFF"
    }
  ]
}