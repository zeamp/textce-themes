{
  "name": "Hearth",
  "author": "Richard Ward (zeamp)",
  "variables": {
    "bg": "#262626",
    "fg": "#EBDBB2",
    "accent": "#FABD2F"
  },
  "globals": {
    "background": "#262626",
    "foreground": "#EBDBB2",
    "caret": "#FABD2F",
    "block_caret": "#FABD2F",
    "line_highlight": "#1C1F20",
    "selection": "#6A5629",
    "selection_border": "#6A5629",
    "inactive_selection": "#1C1F20",
    "misc_highlight": "#3A3634",
    "find_highlight": "#FFCE1B",
    "find_highlight_foreground": "#262626",
    "highlight": "#FABD2F",
    "highlight_foreground": "#262626",
    "brackets_options": "underline",
    "brackets_foreground": "#FABD2F",
    "bracket_contents_options": "underline",
    "bracket_contents_foreground": "#FABD2F",
    "tags_options": "stippled_underline",
    "tags_foreground": "#FABD2F",
    "guide": "#3A3634",
    "active_guide": "#C8BA99",
    "stack_guide": "#3A3634",
    "gutter": "#262626",
    "gutter_foreground": "#A0967D",
    "shadow": "#141617"
  },
  "rules": [
    {
      "name": "comment",
      "scope": "comment, punctuation.definition.comment",
      "foreground": "#A0967D",
      "font_style": "italic"
    },
    {
      "name": "string",
      "scope": "string, punctuation.definition.string",
      "foreground": "#D5DC6A"
    },
    {
      "name": "constant.numeric",
      "scope": "constant.numeric",
      "foreground": "#D8885A"
    },
    {
      "name": "constant.language",
      "scope": "constant.language, constant.character, constant.other",
      "foreground": "#D8885A"
    },
    {
      "name": "keyword",
      "scope": "keyword, storage",
      "foreground": "#DF778F"
    },
    {
      "name": "keyword.operator",
      "scope": "keyword.operator",
      "foreground": "#6EDC6A"
    },
    {
      "name": "entity.name.function",
      "scope": "entity.name.function, support.function, meta.function-call",
      "foreground": "#5AC7D8"
    },
    {
      "name": "entity.name.class",
      "scope": "entity.name.class, entity.name.type, support.class, support.type",
      "foreground": "#DCB26A"
    },
    {
      "name": "entity.other.inherited-class",
      "scope": "entity.other.inherited-class",
      "foreground": "#DCB26A",
      "font_style": "italic"
    },
    {
      "name": "variable.parameter",
      "scope": "variable.parameter",
      "foreground": "#EBDBB2",
      "font_style": "italic"
    },
    {
      "name": "variable",
      "scope": "variable, variable.other",
      "foreground": "#EBDBB2"
    },
    {
      "name": "variable.language",
      "scope": "variable.language, support.constant",
      "foreground": "#DC7A6A"
    },
    {
      "name": "entity.name.tag",
      "scope": "entity.name.tag",
      "foreground": "#DC7A6A"
    },
    {
      "name": "entity.other.attribute-name",
      "scope": "entity.other.attribute-name",
      "foreground": "#DCB26A",
      "font_style": "italic"
    },
    {
      "name": "punctuation",
      "scope": "punctuation, meta.brace",
      "foreground": "#C8BA99"
    },
    {
      "name": "markup.heading",
      "scope": "markup.heading, entity.name.section",
      "foreground": "#FABD2F",
      "font_style": "bold"
    },
    {
      "name": "markup.bold",
      "scope": "markup.bold",
      "foreground": "#EBDBB2",
      "font_style": "bold"
    },
    {
      "name": "markup.italic",
      "scope": "markup.italic",
      "foreground": "#EBDBB2",
      "font_style": "italic"
    },
    {
      "name": "markup.underline.link",
      "scope": "markup.underline.link, string.other.link",
      "foreground": "#83A598",
      "font_style": "underline"
    },
    {
      "name": "markup.quote",
      "scope": "markup.quote",
      "foreground": "#C8BA99",
      "font_style": "italic"
    },
    {
      "name": "markup.raw",
      "scope": "markup.raw, markup.inline.raw",
      "foreground": "#D5DC6A"
    },
    {
      "name": "markup.inserted",
      "scope": "markup.inserted",
      "foreground": "#D5DC6A"
    },
    {
      "name": "markup.deleted",
      "scope": "markup.deleted",
      "foreground": "#DC7A6A"
    },
    {
      "name": "markup.changed",
      "scope": "markup.changed",
      "foreground": "#5AC7D8"
    },
    {
      "name": "invalid",
      "scope": "invalid, invalid.illegal",
      "foreground": "#E69689"
    },
    {
      "name": "invalid.deprecated",
      "scope": "invalid.deprecated",
      "foreground": "#D8885A",
      "font_style": "italic"
    },
    {
      "name": "support.constant.property-value",
      "scope": "support.constant.property-value, meta.property-value",
      "foreground": "#6EDC6A"
    },
    {
      "name": "meta.selector",
      "scope": "meta.selector, entity.other.attribute-name.class, entity.other.attribute-name.id",
      "foreground": "#DCB26A"
    },
    {
      "name": "constant.other.color",
      "scope": "constant.other.color",
      "foreground": "#D8885A"
    },
    {
      "name": "string.regexp",
      "scope": "string.regexp",
      "foreground": "#6EDC6A"
    },
    {
      "name": "constant.character.escape",
      "scope": "constant.character.escape",
      "foreground": "#6EDC6A"
    }
  ]
}